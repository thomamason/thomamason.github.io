---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SocialIcons from "../components/SocialIcons.astro";
import MediaBanner from "../components/MediaBanner.astro";
import VideoHero from "../components/VideoHero.astro";
import Footer from "../components/Footer.astro";
import LogoSection from "../components/LogoSection.astro";
---

<Layout
    title="thomamason dot com"
    description="Home website of Thomas G. Featherstone."
>
    <div id="outerwrapper" class="container-fluid">
        <VideoHero
            videoSrc="/src/Sequence128p.mp4"
            poster="/images/hero-poster.jpg"
            logoSrc="/src/thomamasonlogoedit.png"
            logoAlt="Thomamason [dot] com"
            subheading="təʊ-mɑː-mɑː-sʌn"
            subsubheading=""
        />

        <main>
            <div id="main-content" class="snap-section">
                <LogoSection
                    logoSrc="/src/thomamasonlogoedit.png"
                    logoAlt="Thomamason [dot] com"
                />
                <SocialIcons />

                <div class="container-fluid" id="banners">
                    <MediaBanner
                        id="bandcamp-banner"
                        img="src/splutter.webp"
                        alt="Splutter record art by Jake Kent"
                        caption="Splutter - Punk rock for horrible people."
                    >
                        <iframe
                            style="border: 0; width: 100%; height: 42px;"
                            src="https://bandcamp.com/EmbeddedPlayer/album=2630588570/size=small/bgcol=ffffff/linkcol=0687f5/track=600407455/transparent=true/"
                            seamless
                            ><a
                            href="https://splutter.bandcamp.com/album/songs-from-the-cultural-gulag">SONGS
                            FROM THE CULTURAL GULAG by SPLUTTER</a></iframe
                        >
                    </MediaBanner>
                    <MediaBanner
                        id="bandcamp-banner"
                        img="src/ploughlines.jpg"
                        alt="Plough Lines artwork by Stephen Hill"
                        caption="Plough Lines - Emo music for emo people."
                    />

                    <MediaBanner
                        id="bandcamp-banner"
                        img="src/ftwihathhtts.jpg"
                        alt="Live image of
                            ftwihathhtts by ???"
                        caption="ftwihathhtts - screamo
                            music i made a longggg time ago"
                    />

                    <MediaBanner
                        id="bc-banner"
                        img="/src/mp.jpg"
                        alt="Milk Problems
                            album art"
                        caption="Milk Problems - Music I made on
                            a laptop of no fixed genre"
                    >
                        <iframe
                            style="border:0; width:100%; height:42px;"
                            src="https://bandcamp.com/EmbeddedPlayer/track=2046850880/size=small/bgcol=ffffff/linkcol=0687f5/transparent=true/"
                            seamless
                        >
                            <a
                            href="https://milkproblems.bandcamp.com/track/sea-date">sea
                            date by milk problems</a>
                        </iframe>
                        <iframe
                            style="border:0; width:100%; height:42px;"
                            src="https://bandcamp.com/EmbeddedPlayer/track=954573231/size=small/bgcol=ffffff/linkcol=0687f5/transparent=true/"
                            seamless
                        >
                            <a
                            href="https://milkproblems.bandcamp.com/track/weird-worship-weirdest-worship-ver-1420">weird
                            worship (weirdest worship ver 1.4.20) by milk
                            problems</a>
                        </iframe>
                        <iframe
                            style="border:0; width:100%; height:42px;"
                            src="https://bandcamp.com/EmbeddedPlayer/album=628731983/size=small/bgcol=ffffff/linkcol=0687f5/track=2543285892/transparent=true/"
                            seamless
                        >
                            <a
                            href="https://milkproblems.bandcamp.com/album/vol-1-wasteland">vol
                            1 : wasteland by S H I V V</a>
                        </iframe>
                        <iframe
                            style="border:0; width:100%; height:42px;"
                            src="https://bandcamp.com/EmbeddedPlayer/track=88539351/size=small/bgcol=ffffff/linkcol=0687f5/transparent=true/"
                            seamless
                        >
                            <a
                            href="https://milkproblems.bandcamp.com/track/clinic-hospice">_clinic
                            / hospice by milk problems</a>
                        </iframe>
                    </MediaBanner>

                    <MediaBanner
                        id="yt-banner"
                        img="/src/muxuk.png"
                        alt="Pet Stories album art"
                        caption="'Pet Stories' - a collaborative project with Jaiyu Sai"
                    >
                        <div class="responsive-embed">
                            <iframe
                                src="https://www.youtube.com/embed/0Yttof0hz_0?si=Jp4zeK3vD6vIKLv4"
                                title="YouTube video player"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen></iframe>
                        </div>
                        <div class="responsive-embed">
                            <iframe
                                src="https://www.youtube.com/embed/TWKUG8RkeDU?si=JU0yXWwwbZLY8_IG"
                                title="YouTube video player"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen></iframe>
                        </div>
                        <div class="responsive-embed">
                            <iframe
                                src="https://www.youtube.com/embed/hkJgYbBviCc?si=gFfLFJAJ4Vx51ckK"
                                title="YouTube video player"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen></iframe>
                        </div>
                    </MediaBanner>
                </div>
            </div>
        </main>
    </div>

    <!-- <Footer /> -->
</Layout>
