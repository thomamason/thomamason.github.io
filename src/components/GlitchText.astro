---
interface Props {
    chars?: string;
}

const { chars = "`¡™£¢∞§¶•ªº–≠åß∂ƒ©˙∆˚¬…æ≈ç√∫˜µ≤≥÷/?░▒▓<>/" } = Astro.props;
---

<style is:global>
    .glitch-text .char {
        position: relative;
        display: inline-block;
        opacity: 0;
        animation: glitch-fade-in 0.05s linear forwards;
        animation-delay: calc(
            (var(--char-index, 0) * var(--glitch-char-stagger, 0.03s)) +
                (var(--count, 1) * var(--glitch-group-delay-step, 0.4s))
        );
    }

    .glitch-text .char::before {
        content: var(--char-0);
        position: absolute;
        inset: 0;
        animation: glitch-cycle var(--glitch-cycle-duration, 0.4s) steps(10)
            forwards;
        animation-delay: calc(
            var(--char-index, 0) * var(--glitch-char-stagger, 0.03s)
        );
        font-weight: 700;
        transform: scale(1.05);
    }

    @keyframes glitch-cycle {
        0% {
            content: var(--char-0);
            opacity: 1;
        }
        10% {
            content: var(--char-1);
            opacity: 0.6;
        }
        20% {
            content: var(--char-2);
            opacity: 1;
        }
        30% {
            content: var(--char-3);
            opacity: 0.6;
        }
        40% {
            content: var(--char-4);
            opacity: 1;
        }
        50% {
            content: var(--char-5);
            opacity: 0.6;
        }
        60% {
            content: var(--char-6);
            opacity: 1;
        }
        70% {
            content: var(--char-7);
            opacity: 0.6;
        }
        80% {
            content: var(--char-8);
            opacity: 1;
        }
        90% {
            content: var(--char-9);
            opacity: 0.6;
        }
        100% {
            content: "";
            opacity: 0;
        }
    }

    @keyframes glitch-fade-in {
        to {
            opacity: 1;
        }
    }
</style>

<script define:vars={{ chars }}>
    window.__glitchChars = chars;
</script>

<script>
    import Splitting from "splitting";

    const DEFAULT_CHARS = "`¡™£¢∞§¶•ªº–≠åß∂ƒ©˙∆˚¬…æ≈ç√∫˜µ≤≥÷/?░▒▓<>/";
    const glitchChars = (window.__glitchChars ?? DEFAULT_CHARS).split("");

    function glitchReveal(root, selector = "p") {
        root.classList.add("glitch-text");
        const targets = selector ? root.querySelectorAll(selector) : [root];
        const results = Splitting({ target: targets, by: "chars" });

        for (const result of results) {
            for (const char of result.chars) {
                char.style.setProperty(
                    "--count",
                    String(Math.random() * 5 + 1),
                );
                for (let g = 0; g < 10; g++) {
                    char.style.setProperty(
                        `--char-${g}`,
                        `"${
                            glitchChars[
                                Math.floor(Math.random() * glitchChars.length)
                            ]
                        }"`,
                    );
                }
            }
        }
    }

    window.glitchReveal = glitchReveal;
</script>
