---
import MediaPlayer from "./MediaPlayer.astro";
---

<section class="Gallery">
    <div id="player">
        <MediaPlayer />
    </div>
    <div id="gallery_text">
        <p>
            This is a selection of artistic endeavours I've undertaken in the
            past two decades.
            <br /><br />
            Select a project name from the playlist to listen/watch.
        </p>
    </div>
    <div id="playlist">
        <p>Audio:</p>
        <ul>
            <li id="splutter" data-key="splutter">Splutter</li>
            <li id="ploughlines" data-key="ploughlines">Plough Lines</li>
            <li id="milkproblems" data-key="milkproblems">milk problems</li>
            <li id="shivv" data-key="shivv">S H I V V</li>
            <li id="ftwih" data-key="ftwih">ftwihathhtts</li>
        </ul>

        <p>Video:</p>
        <ul>
            <li id="zoi">tomu et zoi</li>
        </ul>

        <p>Web:</p>
        <ul>
            <li>
                <a href="www.longtimeg.one" target="_blank">longtimeg.one</a>
            </li>
        </ul>
    </div>
</section>

<style>
    .Gallery {
        display: flex;
        flex-direction: row;
        @media (max-width: 768px) {
            align-items: center;
            flex-direction: column;
        }
    }

    #player {
        width: 40%;
    }

    #gallery_text {
        width: 60%;
        button {
            color: var(--green);
        }
        #gallery-source-btn {
            color: var(--white);
            text-decoration: none;
        }
    }

    #playlist {
        width: auto;
        margin: 0 5px 0 5px;
        p {
            color: var(--purple);
        }
        ul {
            list-style: none;
            padding: 0;
            margin: 0 0 1rem 0;
        }
        li {
            cursor: pointer;
        }
        li[data-key]:hover {
            color: var(--green);
        }
        li.active {
            color: var(--green);
        }
        a {
            color: var(--white);
            text-decoration: none;
        }
    }

    #gallery-text-controls {
        display: flex;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }
    #gallery-text-controls button,
    #gallery-text-controls a {
        background: none;
        border: none;
        font-family: var(--font-body);
        font-size: 1rem;
        cursor: pointer;
        text-decoration: none;
    }
    #gallery-play-btn {
        color: var(--purple);
    }
    #gallery-source-btn {
        color: var(--green);
    }

    #now-playing-track {
        color: var(--purple);
        font-size: 0.9em;
    }
</style>

<script>
    type Track = { src: string; title: string };
    type Group = { text: string; source: string; tracks: Track[] };

    const groups: Record<string, Group> = {
        splutter: {
            text: "Splutter<br><br>This band came a little while after Plough Lines while I was playing guitar for a indiepop band. Dick Jones and his old school friend, Kento, brought me and lew onboard to play bass and drums, respectively. Over the course of 6 months we wrote about ten minutes worth of scrappy punk songs about living in Stoke (Locked in a Dungeon), living with animals (Oh Little Dog), and living with Dick Jones (Too Mad To Hang Today). There were a handful of shows, and I remember I had a really lovely bass guitar that I later disassembled for parts to fix something else. Whomp.",
            source: "#",
            tracks: [
                { src: "/audio/splutter-1.mp3", title: "Splutter (Part 1)" },
                { src: "/audio/splutter-2.mp3", title: "Splutter (Part 2)" },
                { src: "/audio/splutter-3.mp3", title: "Splutter (Part 3)" },
            ],
        },
        ploughlines: {
            text: "Plough Lines <br/><br/> I met Dick Jones in 2013 not long after moving to Manchester. I spent an evening at his drinking cheap cider and listening to him recite poetry and wax lyrical about politics and classic literature. At some point in the evening, we decided we should start writing music informed by our mutual love of the music of The Van Pelt and Neil Young. We asked poyd to play drums, and seeing as we were practicing in his basement (and because he was the closest person on hand), we asked c-sinc to join us on bass. We did a few short tours, wrote about ten songs, were joined by OJB when poyd dropped out, and had a good time.",
            source: "#",
            tracks: [
                { src: "/audio/ploughlines-1.mp3", title: "Plough Lines I" },
                { src: "/audio/ploughlines-2.mp3", title: "Plough Lines II" },
            ],
        },
        milkproblems: {
            text: "milk problems <br/><br/> Sometime in early 2014, I decided to start writing music that didn't fit the Plough Lines mould. I recorded it all myself on a terrible focusright interface on a clapped out laptop my dad gave me in a tiny box bedroom overlooking the main street in the student ghetto of Fallowfield. Either inspired by or in spite of my claustraphobic living conditions, I wrote an album of hastily-conceived rough ideas called Wasteland. This featured a cover of PDA by interpol which earned me my very first cease-and-desist email when I put it online.<br/<br><br>I later wrote 'sea date' about a dream I had about marrying no one in particular at the bottom of the ocean, and after some encouragement from friends, roped c-sinc and OJB to play some shows with me. The whole thing was over and done with in about 9 months, but we had a few laughs along the way, which is the main thing. <br><br>In writing 'sea date' I bought some brushes and the barebones of a drum kit, and joined d-rad's bands, commonplace and wet blanket. I forget many of the details of that, but I remember playing shows between Leeds and Glasgow, and recording a few songs I wrote for those projects somewhere in Salford.",
            source: "https://milkproblems.bandcamp.com/",
            tracks: [
                {
                    src: "public/src/milk problems - sea date.mp3",
                    title: "sea date (2016)",
                },
                {
                    src: "/audio/milkproblems-2.mp3",
                    title: "milk problems (b)",
                },
                {
                    src: "/audio/milkproblems-3.mp3",
                    title: "milk problems (c)",
                },
            ],
        },
        shivv: {
            text: "S H I V V <br><br> I recorded milk problems on a pirated copy of ableton, and while I was learning to use the software I made a few more electronica inspired tracks. These were all conceived as being soundtracks to some science-fiction film ideas I had in my head. Mostly what I imagined the kipple from 'Do androids dream of electric sheep' might be like.",
            source: "https://milkproblems.bandcamp.com/",
            tracks: [
                {
                    src: "public/src/milk problems - weird worship (weirdest worship).mp3",
                    title: "S H I V V — weird worship (weirdest worship)",
                },
                {
                    src: "public/src/milk problems - _clinic - hospice.mp3",
                    title: "S H I V V — _clinic - hospice",
                },
                {
                    src: "public/src/S H I V V - pacifist.mp3",
                    title: "S H I V V — pacifist",
                },
            ],
        },
        ftwih: {
            text: "ftwihathhtts<br><br>For This World Is Hollow And These Hands Have Touched The Sky is a slight misremembering of the title of a Star Trek TOS episode I liked. I met BK at a DIY show I put on in 2010(?) and then proceeded to spend every waking hour at his student house in Southampton for a year. I got him and his housemate to help me write the song 'Untitled #4, which convinced the aforementioned housemate that playing music with us was not for him. We got loz to play drums, and my old college friend, Chris, to write lyrics and do vocals.<br><br> I think we were probably the most obnoxious punk band on the South Coast during that time, and our live shows bordered on performance without any semblance of artistry. It was great and I loved it. <br><br> Eventually I moved to Manchester, so we recorded the last batch of songs in Southport and called it a day. The other lads formed Cady and they are still at it to this day.",
            source: "#",
            tracks: [
                {
                    src: "public/src/ftwihathhtts - Untitled #4.mp3",
                    title: "Untitled #4",
                },
                {
                    src: "public/src/ftwihathhtts - Ceremony.mp3",
                    title: "Ceremony",
                },
            ],
        },
    };

    const galleryText =
        document.querySelector<HTMLDivElement>("#gallery_text")!;
    const listItems = Array.from(
        document.querySelectorAll<HTMLLIElement>("#playlist li[data-key]"),
    );

    let currentGroupKey: string | null = null;
    let currentTrackIndex = -1;
    let isPlaying = false;

    function setActiveItem() {
        listItems.forEach((li) => li.classList.remove("active"));
        listItems
            .find((li) => li.dataset.key === currentGroupKey)
            ?.classList.add("active");
    }

    function renderText() {
        if (!currentGroupKey) return;
        const group = groups[currentGroupKey];
        const track = group.tracks[currentTrackIndex];

        galleryText.innerHTML = `
            <div id="gallery-text-controls">
                <button id="gallery-play-btn">${
                    isPlaying ? "[stop]" : "[play]"
                }</button>
                <a id="gallery-source-btn" href="${group.source}" target="_blank">[source]</a>
            </div>
            <p>${group.text}</p>
            <p id="now-playing-track">Now playing: ${track.title} (${
                currentTrackIndex + 1
            }/${group.tracks.length})</p>
        `;
    }

    // `autoplay` controls whether MediaPlayer should start playback immediately.
    function playTrack(
        groupKey: string,
        trackIndex: number,
        autoplay: boolean,
    ) {
        const group = groups[groupKey];
        if (!group) return;
        currentGroupKey = groupKey;
        currentTrackIndex =
            ((trackIndex % group.tracks.length) + group.tracks.length) %
            group.tracks.length;

        const track = group.tracks[currentTrackIndex];
        isPlaying = autoplay;
        renderText();
        setActiveItem();

        document.dispatchEvent(
            new CustomEvent("track:load", {
                detail: { src: track.src, title: track.title, autoplay },
            }),
        );
    }

    listItems.forEach((li) => {
        li.addEventListener("click", () => {
            const key = li.dataset.key!;
            // Selecting an item loads it but does NOT start playback.
            playTrack(key, 0, false);
        });
    });

    // Delegated click handling for the play button rendered inside gallery_text
    galleryText.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.id === "gallery-play-btn") {
            if (!currentGroupKey) return;
            document.dispatchEvent(new CustomEvent("track:toggle"));
        }
    });

    // prev/next from MediaPlayer — step within the current group,
    // preserving whatever the current play/pause state was.
    document.addEventListener("track:nav", (e: Event) => {
        const { direction } = (e as CustomEvent).detail;
        if (!currentGroupKey) {
            const firstKey = listItems[0]?.dataset.key;
            if (firstKey) playTrack(firstKey, 0, false);
            return;
        }
        playTrack(
            currentGroupKey,
            currentTrackIndex + (direction === "next" ? 1 : -1),
            isPlaying,
        );
    });

    // auto-advance to the next track in the group when one ends —
    // keeps playing, since the listener already opted into playback.
    document.addEventListener("track:ended", () => {
        if (!currentGroupKey) return;
        playTrack(currentGroupKey, currentTrackIndex + 1, true);
    });

    // keep the gallery_text play button label in sync with MediaPlayer's state
    document.addEventListener("player:state", (e: Event) => {
        isPlaying = (e as CustomEvent).detail.playing;
        const btn =
            document.querySelector<HTMLButtonElement>("#gallery-play-btn");
        if (btn) btn.textContent = isPlaying ? "[stop]" : "[play]";
    });
</script>
