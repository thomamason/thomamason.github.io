---
import MediaPlayer from "./MediaPlayer.astro";
import GlitchText from "./GlitchText.astro";
---

<section class="Gallery">
    <GlitchText />
    <div id="player">
        <MediaPlayer />
    </div>
    <div id="gallery_text">
        <p>
            This is a selection of artistic endeavours I've undertaken in the
            past two decades.
            <br /><br />
            Select a project name from the playlist to listen/watch. Click the source button to see more.
        </p>
    </div>
    <div id="playlist">
        <p>Audio:</p>
        <ul>
            <li id="splutter" data-key="splutter">Splutter</li>
            <li id="ploughlines" data-key="ploughlines">Plough Lines</li>
            <li id="milkproblems" data-key="milkproblems">milk problems</li>
            <li id="shivv" data-key="shivv">S H I V V</li>
            <li id="ftwih" data-key="ftwih">ftwihathhtts</li>
        </ul>

        <p>Video:</p>
        <ul>
            <li id="zoi">tomu et zoi</li>
        </ul>

        <p>Web:</p>
        <ul>
            <li>
                <a href="www.longtimeg.one" target="_blank">longtimeg.one</a>
            </li>
        </ul>
    </div>
</section>

<style>
    .Gallery {
        display: flex;
        flex-direction: row;
        @media (max-width: 768px) {
            /* align-items: center; */
            flex-direction: column;
        }
    }

    #player {
         width: 35%;
         @media (max-width: 768px) {
           width: 100%;
            position: fixed;
            left: 8px;
            right: 8px;
            bottom: calc(8px + env(safe-area-inset-bottom));
            width: auto;
            z-index: 100;
            background: var(--black);
            margin: 5px;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
        }
+    }
    @media (max-width: 768px) {
            :global(.snap-section:has(#player)) {
                clip-path: inset(0);
            }
        }
    
        /* keep the floating player from covering the end of the page */
        .Gallery {
            @media (max-width: 768px) {
                padding-bottom: 110px;
            }
        }

    #gallery_text {
        --glitch-char-stagger: 0.0015s;
        --glitch-cycle-duration: 0.8s;
        --glitch-group-delay-step: 0.2s;
        width: 60%;
        button {
            color: var(--green);
        }
        #gallery-source-btn {
            color: var(--white);
            text-decoration: none;
        }
         @media (max-width: 768px) {
            width: 100%;
            margin-top: 1rem;
    }

    #playlist {
        width: auto;
        margin: 0 5px 0 5px;
        p {
            color: var(--purple);
        }
        ul {
            list-style: none;
            padding: 0;
            margin: 0 0 1rem 0;
        }
        li {
            cursor: pointer;
        }
        li[data-key]:hover {
            color: var(--green);
        }
        li.active {
            color: var(--green);
        }
        a {
            color: var(--white);
            text-decoration: none;
        }
    }

    #gallery-text-controls {
        display: flex;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }
    #gallery-text-controls button,
    #gallery-text-controls a {
        background: none;
        border: none;
        font-family: var(--font-body);
        font-size: 1rem;
        cursor: pointer;
        text-decoration: none;
    }
    #gallery-play-btn {
        color: var(--purple);
    }
    #gallery-source-btn {
        color: var(--green);
    }

    #now-playing-track {
        color: var(--purple);
        font-size: 0.9em;
    }
</style>

<script>
    type Track = { src: string; title: string };
    type Group = { text: string; source: string; tracks: Track[] };

    type GlitchWindow = Window & {
        glitchReveal: (root: HTMLElement, selector?: string) => void;
    };

    const groups: Record<string, Group> = {
        splutter: {
            text: "Splutter<br><br>egg punks pretending to be chain punks. I played bass on this one.",
            source: "https://splutter.bandcamp.com/album/songs-from-the-cultural-gulag",
            tracks: [
                { src: "/audio/splutter-1.mp3", title: "Splutter (Part 1)" },
                { src: "/audio/splutter-2.mp3", title: "Splutter (Part 2)" },
                { src: "/audio/splutter-3.mp3", title: "Splutter (Part 3)" },
            ],
        },
        ploughlines: {
            text: "Plough Lines <br/><br/> Indie-emo drawing on Neil Young guitar lines and Van Pelt lyrical sensibilities. We went through a few drummers and employed csinc on bass because he was standing there when we decided we needed one.",
            source: "#",
            tracks: [
                { src: "/audio/ploughlines-1.mp3", title: "Plough Lines I" },
                { src: "/audio/ploughlines-2.mp3", title: "Plough Lines II" },
            ],
        },
        milkproblems: {
            text: "milk problems <br/><br/> songs of no particular genre recorded into a rubbish interface in my box bedroom in fallowfield.",
            source: "https://milkproblems.bandcamp.com/",
            tracks: [
                {
                    src: "public/src/milk problems - sea date.mp3",
                    title: "sea date (2016)",
                },
                {
                    src: "/audio/milkproblems-2.mp3",
                    title: "milk problems (b)",
                },
                {
                    src: "/audio/milkproblems-3.mp3",
                    title: "milk problems (c)",
                },
            ],
        },
        shivv: {
            text: "S H I V V <br><br> These were all conceived as being soundtracks to some science-fiction film ideas I had in my head. Mostly what I imagined the kipple from 'Do androids dream of electric sheep' might be like.",
            source: "https://milkproblems.bandcamp.com/",
            tracks: [
                {
                    src: "public/src/milk problems - weird worship (weirdest worship).mp3",
                    title: "S H I V V — weird worship (weirdest worship)",
                },
                {
                    src: "public/src/milk problems - _clinic - hospice.mp3",
                    title: "S H I V V — _clinic - hospice",
                },
                {
                    src: "public/src/S H I V V - pacifist.mp3",
                    title: "S H I V V — pacifist",
                },
            ],
        },
        ftwih: {
            text: "ftwihathhtts<br><br>juvenile screamo from the halcyon days of the early 2010s. Love your friends, die laughing.",
            source: "#",
            tracks: [
                {
                    src: "public/src/ftwihathhtts - Untitled #4.mp3",
                    title: "Untitled #4",
                },
                {
                    src: "public/src/ftwihathhtts - Ceremony.mp3",
                    title: "Ceremony",
                },
            ],
        },
    };

    const galleryText =
        document.querySelector<HTMLDivElement>("#gallery_text")!;
    const listItems = Array.from(
        document.querySelectorAll<HTMLLIElement>("#playlist li[data-key]"),
    );

    let currentGroupKey: string | null = null;
    let currentTrackIndex = -1;
    let isPlaying = false;

    function setActiveItem() {
        listItems.forEach((li) => li.classList.remove("active"));
        listItems
            .find((li) => li.dataset.key === currentGroupKey)
            ?.classList.add("active");
    }

    function renderText() {
        if (!currentGroupKey) return;
        const group = groups[currentGroupKey];
        const track = group.tracks[currentTrackIndex];

        galleryText.innerHTML = `
            <div id="gallery-text-controls">
                <button id="gallery-play-btn">${
                    isPlaying ? "[stop]" : "[play]"
                }</button>
                <a id="gallery-source-btn" href="${group.source}" target="_blank">[source]</a>
            </div>
            <p>${group.text}</p>
            <p id="now-playing-track">Now playing: ${track.title} (${
                currentTrackIndex + 1
            }/${group.tracks.length})</p>
        `;

        (window as unknown as GlitchWindow).glitchReveal(galleryText);
    }

    function playTrack(
        groupKey: string,
        trackIndex: number,
        autoplay: boolean,
    ) {
        const group = groups[groupKey];
        if (!group) return;
        currentGroupKey = groupKey;
        currentTrackIndex =
            ((trackIndex % group.tracks.length) + group.tracks.length) %
            group.tracks.length;

        const track = group.tracks[currentTrackIndex];
        isPlaying = autoplay;
        renderText();
        setActiveItem();

        document.dispatchEvent(
            new CustomEvent("track:load", {
                detail: { src: track.src, title: track.title, autoplay },
            }),
        );
    }

    listItems.forEach((li) => {
        li.addEventListener("click", () => {
            const key = li.dataset.key!;
            playTrack(key, 0, false);
        });
    });

    galleryText.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.id === "gallery-play-btn") {
            if (!currentGroupKey) return;
            document.dispatchEvent(new CustomEvent("track:toggle"));
        }
    });

    document.addEventListener("track:nav", (e: Event) => {
        const { direction } = (e as CustomEvent).detail;
        if (!currentGroupKey) {
            const firstKey = listItems[0]?.dataset.key;
            if (firstKey) playTrack(firstKey, 0, false);
            return;
        }
        playTrack(
            currentGroupKey,
            currentTrackIndex + (direction === "next" ? 1 : -1),
            isPlaying,
        );
    });

    document.addEventListener("track:ended", () => {
        if (!currentGroupKey) return;
        playTrack(currentGroupKey, currentTrackIndex + 1, true);
    });

    document.addEventListener("player:state", (e: Event) => {
        isPlaying = (e as CustomEvent).detail.playing;
        const btn =
            document.querySelector<HTMLButtonElement>("#gallery-play-btn");
        if (btn) btn.textContent = isPlaying ? "[stop]" : "[play]";
    });
</script>
