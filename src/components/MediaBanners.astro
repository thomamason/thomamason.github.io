---
import MediaBanner from "./MediaBanner.astro";
---

<div class="container-fluid" id="banners">
    <MediaBanner
        id="bandcamp-banner-splutter"
        img="src/splutter.webp"
        alt="Splutter record art by Jake Kent"
        caption="Splutter - Punk rock for horrible people."
    >
        <iframe
            style="border: 0; width: 100%; height: 42px;"
            src="https://bandcamp.com/EmbeddedPlayer/album=2630588570/size=small/bgcol=ffffff/linkcol=0687f5/track=600407455/transparent=true/"
            seamless
            ><a
            href="https://splutter.bandcamp.com/album/songs-from-the-cultural-gulag">SONGS
            FROM THE CULTURAL GULAG by SPLUTTER</a></iframe
        >
        <iframe
            style="border: 0; width: 100%; height: 42px;"
            src="https://bandcamp.com/EmbeddedPlayer/album=1681230153/size=small/bgcol=ffffff/linkcol=0687f5/transparent=true/"
            seamless
            ><a href="https://splutter.bandcamp.com/album/demo-2017">DEMO 2017
            by SPLUTTER</a></iframe
        >
    </MediaBanner>

    <MediaBanner
        id="bandcamp-banner-ploughlines"
        img="src/ploughlines.jpg"
        alt="Plough Lines artwork by Stephen Hill"
        caption="Plough Lines - Emo music for emo people."
    >
        <iframe
            style="border: 0; width: 100%; height: 42px;"
            src="https://bandcamp.com/EmbeddedPlayer/album=3146610660/size=small/bgcol=ffffff/linkcol=0687f5/track=3395175204/transparent=true/"
            seamless
            ><a
            href="https://ploughlines.bandcamp.com/album/plough-lines-2">Plough
            Lines by Plough Lines</a></iframe
        >
    </MediaBanner>

    <MediaBanner
        id="bandcamp-banner-ftwihathhtts"
        img="src/ftwihathhtts.jpg"
        alt="Live image of
            ftwihathhtts by ???"
        caption="ftwihathhtts - screamo
            music i made a longggg time ago"
    >
        <iframe
            style="border: 0; width: 100%; height: 42px;"
            src="https://bandcamp.com/EmbeddedPlayer/album=167042611/size=small/bgcol=ffffff/linkcol=0687f5/transparent=true/"
            seamless
            ><a
            href="https://ftwihathhtts.bandcamp.com/album/ghost-columns-and-transparencies">Ghost
            Columns and Transparencies by For This World Is Hollow And These
            Hands Have Touched The Sky</a></iframe
        >
    </MediaBanner>

    <MediaBanner
        id="bandcamp-banner-milkproblems"
        img="/src/mp.jpg"
        alt="Milk Problems
            album art"
        caption="Milk Problems - Music I made on
            a laptop of no fixed genre"
    >
        <iframe
            style="border:0; width:100%; height:42px;"
            src="https://bandcamp.com/EmbeddedPlayer/track=2046850880/size=small/bgcol=ffffff/linkcol=0687f5/transparent=true/"
            seamless
        >
            <a href="https://milkproblems.bandcamp.com/track/sea-date">sea date
            by milk problems</a>
        </iframe>
        <iframe
            style="border:0; width:100%; height:42px;"
            src="https://bandcamp.com/EmbeddedPlayer/track=954573231/size=small/bgcol=ffffff/linkcol=0687f5/transparent=true/"
            seamless
        >
            <a
            href="https://milkproblems.bandcamp.com/track/weird-worship-weirdest-worship-ver-1420">weird
            worship (weirdest worship ver 1.4.20) by milk problems</a>
        </iframe>
        <iframe
            style="border:0; width:100%; height:42px;"
            src="https://bandcamp.com/EmbeddedPlayer/album=628731983/size=small/bgcol=ffffff/linkcol=0687f5/track=2543285892/transparent=true/"
            seamless
        >
            <a
            href="https://milkproblems.bandcamp.com/album/vol-1-wasteland">vol 1
            : wasteland by S H I V V</a>
        </iframe>
        <iframe
            style="border:0; width:100%; height:42px;"
            src="https://bandcamp.com/EmbeddedPlayer/track=88539351/size=small/bgcol=ffffff/linkcol=0687f5/transparent=true/"
            seamless
        >
            <a
            href="https://milkproblems.bandcamp.com/track/clinic-hospice">_clinic
            / hospice by milk problems</a>
        </iframe>
    </MediaBanner>

    <MediaBanner
        id="yt-banner"
        img="/src/muxuk.png"
        alt="Pet Stories album art"
        caption="'Pet Stories' - a collaborative project with Jaiyu Sai"
    >
        <div class="responsive-embed">
            <iframe
                src="https://www.youtube.com/embed/0Yttof0hz_0?si=Jp4zeK3vD6vIKLv4"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen></iframe>
        </div>
        <div class="responsive-embed">
            <iframe
                src="https://www.youtube.com/embed/TWKUG8RkeDU?si=JU0yXWwwbZLY8_IG"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen></iframe>
        </div>
        <div class="responsive-embed">
            <iframe
                src="https://www.youtube.com/embed/hkJgYbBviCc?si=gFfLFJAJ4Vx51ckK"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen></iframe>
        </div>
    </MediaBanner>
</div>
