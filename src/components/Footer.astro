---
const links = [
    {
        href: "/nessposting",
        alt: "Nessposting",
        icon: "fa-solid fa-dog",
    },
];
---

<div class="footer-content" id="footer">
    {
        links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
                <i class={link.icon} style="color: rgb(114, 59, 255);" />
            </a>
        ))
    }
</div>

<style>
    #footer {
        display: absolute;
        width: 100%;
        padding: 20px;
    }
</style>
