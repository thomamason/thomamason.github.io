---
const links = [
    {
        href: "/nessposting",
        alt: "Nessposting",
        icon: "fa-solid fa-dog",
    },
];
---

<div class="container-fluid" id="footer">
    <div class="row">
        <div class="col-12 col-md-6">
            <div class="footer-content">
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <i
                                class={link.icon}
                                style="color: rgb(114, 59, 255);"
                            />
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</div>

<style>
    #footer {
        display: flex;
        justify-content: flex-end;
        width: 100%;
        padding: 20px;
    }
</style>
