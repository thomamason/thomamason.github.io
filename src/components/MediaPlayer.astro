<section class="media-player">
    <span></span>
    <button class="green">[prev]</button>
    <button class="purple">[play]</button>
    <button class="green">[next]</button>
    <button class="purple">[stop]</button>
</section>

<style>
    .media-player {
        display: flex;
        flex-wrap: wrap;
    }
    .green {
        color: var(--green);
    }

    .purple {
        color: var(--purple);
    }

    button {
        background: none;
        border: none;
        font-family: var(--font-body);
        font-size: 1rem;
        cursor: pointer;
    }
</style>
