---
export interface Props {
    id: string;
    img: string;
    alt: string;
    caption: string;
}
const { id, img, alt, caption } = Astro.props;
const dropdownId = `${id}-dropdown`;
---

<div id={id} class="banner">
    <div class="banner-main" data-dropdown-target={dropdownId}>
        <div class="bannerimg"><img src={img} alt={alt} /></div>
        <p>{caption}</p>
        <i class="fa-solid fa-angle-down"></i>
    </div>
    <div id={dropdownId} class="dropdown-content">
        <slot />
    </div>
</div>

<style>
    .banner {
        margin: 20px 0px;
        background-color: rgba(169, 169, 169, 0.7);
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        padding: 8px;
        justify-content: space-between;
    }

    .banner p {
        margin: 5px;
        text-align: center;
        font-size: 12px;
    }

    .banner .bannerimg {
        display: flex;
    }

    .banner .bannerimg img {
        border-radius: 10px;
        width: 48px;
        height: 48px;
        object-fit: cover;
    }

    .banner-main {
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
    }

    #ytmedia-dropdown {
        flex-direction: column;
    }

    .dropdown-content {
        margin-top: 0.8vh;
        z-index: 1;
        display: none;
        flex-direction: column;
    }

    .dropdown-content.open {
        display: flex;
    }

    .responsive-embed {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%;
        overflow: hidden;
    }

    .responsive-embed iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }

    #banners {
        width: 100%;
        max-width: 100%;
    }

    .dropdown-content iframe {
        margin: 8px;
        width: auto;
    }
</style>
